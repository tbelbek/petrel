# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="petrelrtl",  # Must be unique
    name="Petrel",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="Petrel_app",
    stack_size=6 * 1024,   # was 2K: deep scene/widget call chains overflowed it and
                           # corrupted the heap, surfacing as loader 'Out of Memory'
                           # (note: an unrelated 'BusFault' on Exit is still open)
    fap_category="GPIO",
    # Optional values
    # fap_version="0.1",
    fap_icon="petrel_rtl.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/template",
    fap_icon_assets="images",  # Image assets to compile for this application
    fap_libs=["assets", "hwdrivers"],
)
